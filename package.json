{
  "name": "@diamondslab/diamonds-hardhat-foundry",
  "version": "2.4.0",
  "description": "Hardhat plugin that integrates Foundry testing with Diamond proxy contracts, providing deployment helpers and fuzzing support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiamondsLab/diamonds-hardhat-foundry.git"
  },
  "homepage": "https://github.com/diamondslab/diamonds-hardhat-foundry",
  "author": "Am0rfu5",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "ethereum",
    "smart-contracts",
    "hardhat",
    "hardhat-plugin",
    "foundry",
    "forge",
    "diamondslab",
    "diamonds",
    "diamond",
    "solidity",
    "erc-2535",
    "fuzzing",
    "testing",
    "diamond-proxy"
  ],
  "scripts": {
    "lint": "yarn prettier --check && yarn eslint",
    "lint:fix": "yarn prettier --write && yarn eslint --fix",
    "eslint": "eslint 'src/**/*.ts'",
    "prettier": "prettier \"**/*.{js,md,json}\"",
    "pretest": "yarn build",
    "test": "mocha --recursive \"test/**/*.ts\" --exit",
    "build": "tsc --build . && mkdir -p dist/templates && cp src/templates/*.template dist/templates/",
    "copy-templates": "mkdir -p dist/templates && cp src/templates/*.template dist/templates/",
    "prepublishOnly": "yarn build",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "files": [
    "dist/",
    "contracts/",
    "/LICENSE",
    "/README.md",
    "/CHANGELOG.md"
  ],
  "devDependencies": {
    "@diamondslab/diamonds": "^1.4.0",
    "@diamondslab/hardhat-diamonds": "^1.2.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@types/chai": "^4.2.0",
    "@types/debug": "^4.1.12",
    "@types/mocha": ">=9.1.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "5.61.0",
    "@typescript-eslint/parser": "5.61.0",
    "chai": "^4.2.0",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-mocha": "10.4.1",
    "eslint-plugin-prettier": "3.4.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.0",
    "mocha": "^10.0.0",
    "prettier": "2.4.1",
    "rimraf": "^3.0.2",
    "ts-node": "^10.8.0",
    "typescript": "~5.0.0"
  },
  "peerDependencies": {
    "@diamondslab/diamonds": "^1.4.0",
    "@diamondslab/hardhat-diamonds": "^1.2.0",
    "@nomicfoundation/hardhat-ethers": "*",
    "ethers": "^6.0.0",
    "hardhat": "^2.28.0"
  },
  "dependencies": {
    "picocolors": "^1.1.0"
  },
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts/*": "./contracts/*",
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  }
}
